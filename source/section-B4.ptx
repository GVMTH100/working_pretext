    <example>
        <introduction>
            <p>
                A function is given in each of its three forms.  Determine how you would evaluate functional values for each representation.  
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <alert>Function Notation</alert>
                </p>
                <sidebyside>
                    <stack>
                        <p>
                            <m>f(x)=2x+5</m>
                        </p>
                    </stack>
                    <stack>
                        <p>
                            <m>f(2)=</m>
                        </p>
                        <p>
                            .
                        </p>
                        <p>
                            <m>f(4)=</m>
                        </p>
                        <p>
                            .
                        </p>
                        <p>
                            Find <m>x</m> when <m>f(x)=11</m>
                        </p>
                    </stack>
                </sidebyside>
            </statement>
        </task>
         <task>
