                    <cell>141</cell>
                    <cell>144</cell>
                </row>
            </tabular>
        </introduction>
        <task workspace="0.25in">
            <statement>
                <p>
                   Choose a number on the interior of the table and describe the pattern as you move up from that position. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move up a column of the table the values are decreasing by 21
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move down diagonally to the right.
                </p>
            </statement>
            <solution>
                <p>
                    As we move down and right along a diagonal the values are increasing by 24.
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move to the left. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move to the left on the table the values are decreasing by 3.  
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    Choose one square from the interior of the table and replace the value with <m>n</m>. Write each of the values around this number in terms of <m>n</m>, using the patterns you described above.
                </p>
                <tabular left="minor" top="minor" halign="center">
          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <m>n</m> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>
        </tabular>
            </statement>
        <solution>
            <p>
                <tabular left="minor" top="minor" right="minor" bottom="minor" halign="center">
                    <row>
                        <cell><m>n-27</m></cell>
                        <cell><m>n-24</m></cell>
                        <cell><m>n-21</m></cell>
                    </row>
                    <row>
                        <cell><m>n-3</m></cell>
                        <cell><m>n</m></cell>
                        <cell><m>n+3</m></cell>
                    </row>
                    <row>
                        <cell><m>n+21</m></cell>
                        <cell><m>n+24</m></cell>
                        <cell><m>n+27</m></cell>
                    </row>
                </tabular>
            </p>
        </solution>
        </task>
