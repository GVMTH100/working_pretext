                    <cell>89</cell>
                    <cell>91</cell>
                    <cell>93</cell>
                    <cell>95</cell>
                    <cell>97</cell>
                </row>
            </tabular>
        </introduction>
        <task workspace="0.25in">
            <statement>
                <p>
                   Choose a number on the interior of the table and describe the pattern as you move up from that position. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move up a column of the table the values are decreasing by 14
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move down diagonally to the right.
                </p>
            </statement>
            <solution>
                <p>
                    As we move down and right along a diagonal the values are increasing by 16.
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move to the left. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move to the left on the table the values are decreasing by 2.  
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    Choose one square from the interior of the table and replace the value with <m>n</m>. Write each of the values around this number in terms of <m>n</m>, using the patterns you described above.
                </p>
                <tabular left="minor" top="minor" halign="center">
          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <m>n</m> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>
        </tabular>
            </statement>
        <solution>
            <p>
                <tabular left="minor" top="minor" right="minor" bottom="minor" halign="center">
                    <row>
                        <cell><m>n-16</m></cell>
                        <cell><m>n-14</m></cell>
                        <cell><m>n-12</m></cell>
                    </row>
                    <row>
                        <cell><m>n-2</m></cell>
                        <cell><m>n</m></cell>
                        <cell><m>n+2</m></cell>
                    </row>
                    <row>
                        <cell><m>n+12</m></cell>
                        <cell><m>n+14</m></cell>
                        <cell><m>n+16</m></cell>
                    </row>
                </tabular>
            </p>
        </solution>
        </task>
    </exercise>

    <exercise>
        <p>
            Generalize the solution to this polygon puzzle by writing the upper left corner as <m>p</m>
            and then writing the remaining vertices in terms of <m>p</m>.
        </p>
        <image source="puzzle_rev3.png" width="35%">
            <shortdescription>Square polygon puzzle with sides 10, 13, 14, and 11 moving clockwise around the square. </shortdescription>
        </image>
        <solution>
            <p>
                To find the upper right vertex we subtract <m>p</m> from 10.  
                To find the lower left vertex we subtract <m>p</m> from 11.
                To find the lower right vertex we can subtract <m>10-p</m> from 13.
                <md>
                    13-(10-p)
                </md>
                <md>
                    13-10-(-p)
                </md>
                <md>
                    3+p
                </md>
                To find the lower right vertex we could also have subtracted <m>11-p</m> from 14.
                <md>14-(11-p)</md>
                <md>14-11-(-p)</md>
                <md>3+p</md>
            </p>
            <image source="puzzle_rev3A.png" width="35%">
            <shortdescription>Square polygon puzzle with sides 10, 13, 14, and 11 moving clockwise around the square. </shortdescription>
        </image>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for the sum of 4 and 2 times a number.
        </p>
        <solution>
            <p>
                <m>4+2n</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for the product of 12 and the square root of a number.
        </p>
        <solution>
            <p>
                <m>12\sqrt{n}</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for the sum of three consecutive numbers.
        </p>
        <solution>
            <p>
                <m>n+(n+1)+(n+2)</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for the quotient of 2 and the sum of a number and 6.
        </p>
        <solution>
            <p>
                <m>\frac{2}{n+6}</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for the difference of a number and its square.
        </p>
        <solution>
            <p>
                <m>n-n^2</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.25in">
        <p>
            Write an expression for difference of a number and its reciprocal. 
        </p>
        <solution>
            <p>
                <m>n+\frac{1}{n}</m>
            </p>
        </solution>
    </exercise>

