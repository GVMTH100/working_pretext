<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="MTBSO4" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Basic Skill and Operations #4</title>

    <objectives>
                    <ul><li>    <p>
                    <alert>BSO #4:</alert> I can identify a numerical pattern and generalize the pattern using variables.
                </p></li></ul>
            
    </objectives>

     <exercise>
        <introduction>
            <p>
                Consider the following table which lists the multiples of 5 from 0 to 240.
            </p>
            <tabular halign="center" top="minor" bottom="minor" left="minor" right="minor">
                <row>
                    <cell>30</cell>
                    <cell>25</cell>
                    <cell>20</cell>
                    <cell>15</cell>
                    <cell>10</cell>
                    <cell>5</cell>
                    <cell>0</cell>
                </row>
                <row>
                    <cell>65</cell>
                    <cell>60</cell>
                    <cell>55</cell>
                    <cell>50</cell>
                    <cell>45</cell>
                    <cell>40</cell>
                    <cell>35</cell>
                </row>
                <row>
                    <cell>100</cell>
                    <cell>95</cell>
                    <cell>90</cell>
                    <cell>85</cell>
                    <cell>80</cell>
                    <cell>75</cell>
                    <cell>70</cell>
                </row>
                <row>
                    <cell>135</cell>
                    <cell>130</cell>
                    <cell>125</cell>
                    <cell>120</cell>
                    <cell>115</cell>
                    <cell>110</cell>
                    <cell>105</cell>
                </row>
                <row>
                    <cell>170</cell>
                    <cell>165</cell>
                    <cell>160</cell>
                    <cell>155</cell>
                    <cell>150</cell>
                    <cell>145</cell>
                    <cell>140</cell>
                </row>
                <row>
                    <cell>205</cell>
                    <cell>200</cell>
                    <cell>195</cell>
                    <cell>190</cell>
                    <cell>185</cell>
                    <cell>180</cell>
                    <cell>175</cell>
                </row>
                <row>
                    <cell>240</cell>
                    <cell>235</cell>
                    <cell>230</cell>
                    <cell>225</cell>
                    <cell>220</cell>
                    <cell>215</cell>
                    <cell>210</cell>
                </row>
            
            </tabular>
        </introduction>
        <task workspace="0.25in">
            <statement>
                <p>
                   Choose a number on the interior of the table and describe the pattern as you move up from that position. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move up a column of the table the values are decreasing by 35
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move down diagonally to the right.
                </p>
            </statement>
            <solution>
                <p>
                    As we move down and right along a diagonal the values are decreasing by 30.
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move to the left. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move to the left on the table the values are increasing by 5.  
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    Choose one square from the interior of the table and replace the value with <m>n</m>. Write each of the values around this number in terms of <m>n</m>, using the patterns you described above.
                </p>
                <tabular left="minor" top="minor" halign="center">
          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <m>n</m> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>
        </tabular>
            </statement>
        <solution>
            <p>
                <tabular left="minor" top="minor" right="minor" bottom="minor" halign="center">
                    <row>
                        <cell><m>n-30</m></cell>
                        <cell><m>n-35</m></cell>
                        <cell><m>n-40</m></cell>
                    </row>
                    <row>
                        <cell><m>n+5</m></cell>
                        <cell><m>n</m></cell>
                        <cell><m>n-5</m></cell>
                    </row>
                    <row>
                        <cell><m>n+40</m></cell>
                        <cell><m>n+35</m></cell>
                        <cell><m>n+30</m></cell>
                    </row>
                </tabular>
            </p>
        </solution>
        </task>
    </exercise>

</worksheet>
