<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="BSO3_PP" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Basic Skills and Operations #3</title>

    <objectives>
                    <ul>
                       
                <li>    <p>
                    <alert>BSO #3:</alert> I can simplify algebraic expressions by combining like terms.
                </p></li>
                
                </ul>
            
    </objectives>

    <exercise>
        
   
     <task workspace="0.5in">
            <statement>
                <p>
                    <m>(3x^2+2x+7)+(2x^2-8x+9)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>
                        (3x^2+2x+7)+(2x^2-8x+9)
                    </md>
                    <md>
                        (3x^2+2x^2)+(2x-8x)+(7+9)
                    </md>
                    
                    <md>5x^2-6x+16</md>
                </p>
            </solution>
        </task>
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(-4y^2+3y-10)+(-2y^2-5y-6)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(-4y^2+3y-10)+(-2y^2-5y-6)</md>
                    <md>(-4y^2-2y^2)+(3y-5y)+(-10-6)</md>
                    <md>-6y^2-2y-16</md>
                </p>
            </solution>
        </task>
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(3x^2+7x-9)+(4x^2+3x-2)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(3x^2+7x-9)+(4x^2+3x-2)</md>
                    <md>(3x^2+4x^2)+(7x+3x)+(-9-2)</md>
                    <md>7x^2+10x-11</md>
                </p>
            </solution>
        </task>
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(2x^2+7x-9)+(-5x^2+x-2)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(2x^2+7x-9)+(-5x^2+x-2)</md>
                    <md>(2x^2-5x^2)+(7x+x)+(-9-2)</md>
                    <md>-3x^2+8x-11</md>
                </p>
            </solution>
        </task>
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(7y^2+7y-12)+(3y^2+2y-6)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(7y^2+7y-12)+(3y^2+2y-6)</md>
                    <md>(7y^2+3y^2)+(7y+2y)+(-12-6)</md>
                    <md>10y^2+9y-18</md>
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <introduction>
            <p>
                Simplify the following expressions.
            </p>
        </introduction>
       
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(3a-5b+17)+(2a-3b+2)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(3a-5b+17)+(2a-3b+2)</md>
                    <md>(3a+2a)+(-5b-3b)+(17+2)</md>
                    <md>5a-8b+19</md>
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(4a-5b+3c)+(-4a+7b+2c-9)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(4a-5b+3c)+(-4a+7b+2c-9)</md>
                    <md>(4a-4a)+(-5b+7b)+(3c+2c)+(-9)</md>
                    <md>2b+5c-9</md>
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(9a+4b-c-9)+(2a+7b-3c+6)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(9a+4b-c-9)+(2a+7b-3c+6)</md>
                    <md>(9a+2a)+(4b+7b)+(-c-3c)+(-9+6)</md>
                    <md>11a+11b-4c-3</md>
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    <m>(6a+2b-5c+9)+(-2a-2b+3c-5)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>(6a+2b-5c+9)+(-2a-2b+3c-5)</md>
                    <md>(6a-2a)+(2b-2b)+(-5c+3c)+(9-5)</md>
                    <md>4a-2c+4</md>
                </p>
            </solution>
        </task>
    </exercise>
    <exercise>
        <introduction>
            <p>
                Simplify the following expressions.
            </p>
        </introduction>
       
        <task workspace="0.5in">
            <statement>
                <p>
                    <m>2(x+4)+5x-3</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>2(x+4)+5x-3</md>
                    <md>2x+8+5x-3</md>
                    <md>(2x+5x)+(8-3)</md>
                    <md>7x+5</md>
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    <m>3x-4-(x+5)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>3x-4-(x+5)</md>
                    <md>3x-4-x-5</md>
                    <md>(3x-x)+(-4-5)</md>
                    <md>2x-9</md>
                </p>
            </solution>
        </task>

         <task workspace="0.5in">
            <statement>
                <p>
                    <m>5(2x-4)-3(3x+4)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>5(2x-4)-3(3x+4)</md>
                    <md>10x-20-9x-12</md>
                    <md>(10x-9x)+(-20-12)</md>
                    <md>x-32</md>
                </p>
            </solution>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    <m>-2(2x+8)+4(3x+5)</m>
                </p>
            </statement>
            <solution>
                <p>
                    <md>-2(2x+8)+4(3x+5)</md>
                    <md>-4x-16+12x+20</md>
                    <md>(-4x+12x)+(-16+20)</md>
                    <md>8x+4</md>
                </p>
            </solution>
        </task>

    </exercise>


</worksheet>