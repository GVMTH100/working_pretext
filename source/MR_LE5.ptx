<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="LE5_PP" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Linear Equations #5</title>

    <objectives>
                    <ul>
                        
                <li>    <p>
                    <alert>LE #5:</alert> I can solve linear equations symbolically or with a graph.    
                </p></li>
                </ul>
            
    </objectives>

    <p>
        <alert>Directions:</alert> Solve each equation for the given variable.
    </p>

    <exercise workspace="0.5in">
        <p>
             <m>3x+5=2x-9</m>
        </p>
        <solution>
            <p>
                <md>
                    3x+5=2x-9
                </md>
                <md>
                    3x+5-2x=2x-9-2x
                </md>
                <md>
                    x+5=-9
                </md>
                <md>
                    
                x+5-5=-9-5</md>
                <md>
                    
                x=-14</md>
                
                
                
                
            </p>
        </solution>
       
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>5x-2(x+4)=7x-7</m>
        </p>
        <solution>
            <p>
                <md>
                    5x-2(x+4)=7x-7
                </md>
                <md>
                    5x-2x-8=7x-7
                </md>
                <md>
                   3x-8=7x-7 
                </md>
                <md>
                   3x-8-7x=7x-7-7x 
                </md>
                <md>
                    
                -4x-8=-7</md>
                <md>
                    
               -4x-8+8=-7+8 </md>
               <md>
                -4x=1
               </md>
               <md>
                \frac{-4x}{-4}=\frac{1}{-4}
               </md>
               <md>
                x=-\frac{1}{4}
               </md>
               
               
                
                
            </p>
        </solution>
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>3x+7(x-4)=9x+7</m>
        </p>
        <solution>
            <p>
                <md>
                    3x+7(x-4)=9x+7
                </md>
                <md>
                    3x+7x-28=9x+7
                </md>
                <md>
                    10x-28=9x+7
                </md>
                <md>
                    10x-28-9x=9x+7-9x
                </md>
                <md>
                    x-28=7
                </md>
                <md>
                    x-28+28=7+28
                </md>
                <md>
                    x=35
                </md>
                
                
            </p>
        </solution>
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>\frac{1}{3}\left(x+5\right)-2=\frac{4}{5}x-\frac{3}{7}</m>
        </p>
        <solution>
            <p>
                <md>
                    \frac{1}{3}\left(x+5\right)-2=\frac{4}{5}x-\frac{3}{7}
                </md>
                <md>
                    \frac{1}{3}x+\frac{5}{3}-2=\frac{4}{5}x-\frac{3}{7}
                </md>
                <md>
                   \frac{1}{3}x-\frac{1}{3}=\frac{4}{5}x-\frac{3}{7}
                </md>
                <md>
                    \frac{1}{3}x-\frac{1}{3}-\frac{4}{5}x=\frac{4}{5}x-\frac{3}{7}-\frac{4}{5}x
                </md>
                <md>
                    -\frac{7}{15}x-\frac{1}{3}=-\frac{3}{7}
                </md>
                <md>
                    -\frac{7}{15}x-\frac{1}{3}+\frac{1}{3}=-\frac{3}{7}+\frac{1}{3}
                </md>
                <md>
                    -\frac{7}{15}x=-\frac{2}{21}
                </md>
                <md>
                   \left(-\frac{15}{7}\right)\left(-\frac{7}{15}x\right)=\left(-\frac{15}{7}\right)\left(-\frac{2}{21}\right) 
                </md>
                <md>
                    x=\frac{10}{49}
                </md>
                
                
                
                
                
                
                
                
            </p>
        </solution>
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>1.4x-8.2=12.8x+4.7</m>
        </p>
        <solution>
            <p>
                <md>
                    1.4x-8.2=12.8x+4.7
                </md>
                <md>
                    1.4x-8.2-12.8x=12.8x+4.7-12.8x
                </md>
                <md>
                    -11.4x-8.2=4.7
                </md>
                <md>
                    -11.4x-8.2+8.2=4.7+8.2
                </md>
                <md>
                    -11.4x=12.9
                </md>
                <md>
                    \frac{-11.4x}{-11.4}=\frac{12.9}{-11.4}
                </md>
                <md>
                    x\approx-1.132
                </md>
                
            </p>
        </solution>
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>2\left(x-7\right)+3=-4\left(3x+5\right)-2x</m>
        </p>
        <solution>
            <p>
                <md>
                    2\left(x-7\right)+3=-4\left(3x+5\right)-2x
                </md>
                <md>
                    2x-14+3=-12x-20-2x
                </md>
                <md>
                    2x-11=-14x-20
                </md>
                <md>
                   2x-11+14x=-14x-20+14x 
                </md>
                <md>
                   16x-11=-20 
                </md>
                <md>
                    16x-11+11=-20+11
                </md>
                <md>
                    16x=-9
                </md>
                <md>
                    \frac{16x}{16}=\frac{-9}{16}
                </md>
                <md>
                    x=-\frac{9}{16}
                </md>
                
            </p>
        </solution>
    </exercise>
    <exercise workspace="0.5in">
        <p>
            <m>4x-8=13x-8</m>
        </p>
        <solution>
            <p>
                <md>
                    4x-8=13x-8
                </md>
                <md>
                    4x-8-13x=13x-8-13x
                </md>
                <md>
                    -9x-8=-8
                </md>
                <md>
                    -9x-8+8=-8+8
                </md>
                <md>
                    -9x=0
                </md>
                <md>
                    \frac{-9x}{-9}=\frac{0}{-9}
                </md>
                <md>
                    x=0
                </md>
                
            </p>
        </solution>
    </exercise>
</worksheet>

