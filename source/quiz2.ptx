              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>
        </tabular>
            </statement>
        <solution>
            <p>
                <tabular left="minor" top="minor" right="minor" bottom="minor" halign="center">
                    <row>
                        <cell><m>n+40</m></cell>
                        <cell><m>n+35</m></cell>
