<worksheet>
<title>Calendar</title>
<introduction>
    <tabular bottom="minor" top="minor" right="minor" left="minor">
        <row header="yes">
            <cell>Week</cell>
            <cell>Day 1</cell>
            <cell>Day 2</cell>
        </row>
        <row>
            <cell>Week 1</cell>
            <cell>
                <line>Examples 1 - 2</line>
                <line>Assign goal setting reading</line>
            </cell>
            <cell><line>Example 3</line>
                <line>Assign mindset reading</line>
            </cell>
        </row>
        <row>
            <cell>Week 2</cell>
            <cell>
                <line>Examples 4 - 5</line>
                <line>Assign Motivation/Procrastination reading</line>
                <line><alert>DUE:</alert> Mathematical Mindset #1</line>
            </cell>
            <cell>
            <line>Examples 6 -8</line></cell>
        </row>
        <row>
            <cell>Week 3</cell>
            <cell>
            <line>Examples 9 - 12</line>
            <line><alert>DUE: </alert>Homework Set 1</line></cell>
            <cell><line>Examples 13 - 16a</line>
