<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="HW4" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Homework Set 4</title>
  
  <introduction>
    <p>
      <alert>Directions:</alert> Complete each of the following problems showing work and supporting your answers with appropriate explanation.  You are welcome to use notes and a graphing calculator to complete these problems.  Other resources are not permitted.  Collaboration with other students in the class is allowed, but please note any collaborators on your homework sheet.
    </p>
  </introduction>
<exercise xml:id="HW3E">
      <statement>
        <p>
          Simplify each of the following expressions by combining like terms.   
        </p>
        
      
      <task workspace="0.25in">
        <statement>
          <p>
            <m>3x^2+5x-4+2(3x+1)</m>
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            <m>-x^2+8x+2+2x^2-8x+9</m>
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            <m>2(x+4)+5x-3x^2+7</m>
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            <m>3x+4y-2+5x-9y+7</m>
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            <m>3(a-3b-1)-2(b+4c+3)</m>
          </p>
        </statement>
      </task>
      </statement>
    </exercise>  

</worksheet>