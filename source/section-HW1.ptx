      <task workspace="0.25in">
        <statement>
          <p>
            24
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            75
          </p>
        </statement>
      </task>
      <task workspace="0.25in">
        <statement>
          <p>
            124
          </p>
        </statement>
      </task>
    </exercise>

    <exercise>
      <introduction>
        <p>
          Find a set of consecutive numbers that add up to the following value, or explain why no such set is possible.
        </p>
