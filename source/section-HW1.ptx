    </exercise>

    <exercise>
     <introduction>
      <p>
        Consider the following expressions.
        Evaluate each of these, following the prescribed order of operations.
      </p>
    </introduction>
       <task workspace="0.5in">
      <statement>
        <p>
          <m>3^2-4\cdot8+3(7-1)</m>
        </p>
      </statement>
    </task>

    <task workspace="0.5in">
      <statement>
        <p>
          <m>\frac{4+2}{3-1}\cdot5-\sqrt{4+12}</m>
        </p>
      </statement>
    </task>

    <task workspace="0.5in">
      <statement>
        <p>
          <m>9-3\cdot2^2+5(2+3)</m>
        </p>
      </statement>
    </task>

    <task workspace="0.5in">
      <statement>
        <p>
          <m>(4-2)\div2(3+4)</m>
        </p>
      </statement>
    </task>
    
    </exercise>

    <exercise xml:id="HW-1A">
      <introduction>
        <p>
          While working on the four-fours problem (<xref ref="exA-FF"/>), students solved the following expression in these four ways.
          
            <md>
              <mrow> \amp 4 + 4 / \sqrt{4} \times \sqrt{4} \amp \amp 4 + 4 / \sqrt{4} \times \sqrt{4} \amp \amp 4 + 4 / \sqrt{4} \times \sqrt{4} \amp \amp 4 + 4 / \sqrt{4} \times \sqrt{4}</mrow>
              <mrow> \amp = 4 + 4 / 2 \times 2 \amp \amp = 4 + 4 / 2 \times 2 \amp \amp = 4 + 4 / 2 \times 2 \amp \amp = 4 + 4 / 2 \times 2</mrow>
              <mrow> \amp = 4 + 4 / 4 \amp \amp = 8 / 4 \amp \amp = 4 + 2 \times 2 \amp \amp = 4 + 2 \times 2</mrow>
              <mrow> \amp = 4 + 1 \amp \amp = 2 \amp \amp = 4 + 4 \amp \amp = 6 \times 2</mrow>
              <mrow> \amp = 5 \amp \amp \amp \amp = 8 \amp \amp = 12</mrow>
            </md>
            
          
        </p>
      </introduction>

      <task workspace="0.5in">
        <statement>
          <p>
            Only one solution can be correct. Which one is it? How do you know?
          </p>
        </statement>
      </task>

      <task workspace="1in">
        <statement>
          <p>
            For the solutions above that are incorrect, identify the error(s) the student made.
          </p>
        </statement>
      </task>
    </exercise>

<exercise>
      <introduction>
        <p>
          For each of the following equations verify that the given statement is false.  Then insert parentheses into the equations to make the statement true.
        </p>
      </introduction>

      <task workspace="0.5in">
        <statement>
          <p>
             <m>4 + 4 \div .4 \div \sqrt{4} = 7</m>.
          </p>
        </statement>
      </task>
      <task workspace="0.5in">
        <statement>
          <p>
            <m>\sqrt{4}^{\sqrt{4}} + \sqrt{4} / 4 = 4</m>.
          </p>
        </statement>
      </task>
      
    </exercise>

      
</worksheet>