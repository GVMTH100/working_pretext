<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="MTBSO5" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Basic Skill and Operations #5</title>

    <objectives>
                    <ul>
                        <li>    <p>
                    <alert>BSO #5:</alert> I can translate written words into
                    mathematical expressions.
                </p></li>
            </ul>
            
    </objectives>

    <exercise workspace="0.5in">
        <p>
            Write an expression for the product of 3 and the reciprocal of a number.
        </p>
        <solution>
            <p>
                <m>3\frac{1}{n}</m>
            </p>
        </solution>
    </exercise>

    <exercise workspace="0.5in">
        <p>
            Write an expression for the difference of 12 and the product of 2 and a number.
        </p>
        <solution>
            <p>
                <m>12-2n</m>
            </p>
        </solution>
    </exercise>

</worksheet>