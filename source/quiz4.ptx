<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="quiz4" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Quiz 4</title>
  
  <objectives>
    <ul>
        <li>
            <p>
                <alert>BSO3:</alert> I can simplify algebraic expressions by combining like terms.
            </p>
        </li>
        <li>
            <p>
               <alert>BOS5:</alert> I can translate written words into mathematical expressions.
            </p>
        </li>
        <li>
                <p>
                    <alert>LE5:</alert> I can solve linear equations symbolically or with a graph. 
                </p>
            </li>
    </ul>
  </objectives>
  <exercise>
    <introduction>
        <p>
            <alert>BSO3:</alert> Simplify each of the following expressions.
        </p>
    </introduction>
    <task workspace="0.5in">
        <statement>
            <p>
                <m>(3x+9)+(5x+2)</m>
            </p>
        </statement>
        <solution>
            <p>
                <m>8x+11</m>
            </p>
        </solution>
    </task>
    <task workspace="0.5in">
        <statement>
            <p>
                <m>(3a+7b-5)+(4a-5b+2)</m>
            </p>
        </statement>
        <solution>
            <p>
                <m>7a+2b-3</m>
            </p>
        </solution>
    </task>
  </exercise>
  <exercise>
    <introduction>
        <p>
            <alert>BSO3:</alert> Simplify each of the following expressions:
        </p>
    </introduction>
    <task workspace="1in">
        <statement>
            <p>
                <m>3x^2+5x+2+3(x^2+2x-1)</m>
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    3x^2+5x+2+3(x^2+2x-1)
                </md>
                <md>
                    3x^2+5x+2+3x^2+6x-3
                </md>
                <md>
                    6x^2+11x-1
                </md>
                
                
                
            </p>
        </solution>
    </task>
    <task workspace="1in">
        <statement>
            <p>
                <m>(3m-7)-(5m+2)</m>
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    (3m-7)-(5m+2)
                </md>
                <md>
                    3m-7-5m-2
                </md>
                <md>
                    -2m-9
                </md>
                
            </p>
        </solution>
    </task>
  </exercise>
  <exercise workspace="0.25in">
    <p>
        <alert>BSO5:</alert> Write an expression for the square root of the sum of a number and 10.
    </p>
    <solution>
        <p>
            <m>\sqrt{n+10}</m>
        </p>
    </solution>
  </exercise>
  <exercise workspace="0.25in">
    <p>
        <alert>BS05:</alert> Write an expression for the difference of 10 and the quotient of 2 and a number.
    </p>
    <solution>
        <p>
            <m>10-\frac{2}{n}</m>
        </p>
    </solution>
  </exercise>
  <exercise>
    <introduction>
        <p>
            <alert>LE5:</alert> Solve the following equations for <m>x</m>.
        </p>
    </introduction>
    <task workspace="1.5in">
        <statement>
            <p>
                <m>3x-7=5x+15</m>
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    3x-7=5x+15
                </md>
                <md>
                    3x-7-5x=5x+15-5x
                </md>
                <md>
                    -2x-7=15
                </md>
                <md>
                    -2x-7+7=15+7
                </md>
                <md>
                    -2x=22
                </md>
                <md>
                    \frac{-2x}{-2}=\frac{22}{-2}
                </md>
                <md>
                    x=-11
                </md>
                
                
                
            </p>
        </solution>
    </task>
    <task workspace="1.5in">
        <statement>
            <p>
                <m>3(2x-7)+5=4x-9</m>
            </p>
        </statement>
        <solution>
            <p>
                <md>3(2x-7)+5=4x-9</md>
                <md>
                    6x-21+5=4x-9
                </md>
                <md>
                    6x-16=4x-9
                </md>
                <md>
                    6x-16-4x=4x-9-4x
                </md>
                <md>
                    2x-16=-9
                </md>
                <md>
                    2x-16+16=-9+16
                </md>
                <md>
                    2x=7
                </md>
                <md>
                    \frac{2x}{2}=\frac{7}{2}
                </md>
                <md>
                    x=\frac{7}{2}
                </md>
                
                
            </p>
        </solution>
    </task>
  </exercise>

</worksheet>