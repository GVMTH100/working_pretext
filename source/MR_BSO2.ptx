<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="BSO2_PP" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Basic Skills and Operations #2</title>

    <objectives>
                    <ul>
                    <li>    <p>
                    <alert>BSO #2:</alert> I can properly apply the order of operations to evaluate a numerical expression. 
                </p></li>
                </ul>
            
    </objectives>

    <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            \frac{3-7}{5-3}+3\cdot4+(2-7)^2
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            \frac{3-7}{5-3}+3\cdot4+(2-7)^2
            </md>
            <md>
                \frac{-4}{5-3}+3\cdot4+(2-7)^2
            </md>
            <md>
                \frac{-4}{2}+3\cdot4+(2-7)^2
            </md>
            <md>
                \frac{-4}{2}+3\cdot4+(-5)^2
            </md>
            <md>
                \frac{-4}{2}+3\cdot4+25
            </md>
            <md>
                -2+3\cdot4+25
            </md>
            <md>
                -2+12+25
            </md>
            <md>
                10+25
            </md>
            <md>
                35
            </md>
            
        </p>
    </solution>
    
  </exercise>

  <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            3\sqrt{4\cdot5-(3+1)}-5(2-7)+4\div2^2-7
        </md>
    </p>
    <solution>
        <p>
           <md>
            3\sqrt{4\cdot5-4}-5(2-7)+4\div2^2-7
        </md> 
         <md>
            3\sqrt{20-4}-5(2-7)+4\div2^2-7
        </md> 
        <md>
            3\sqrt{16}-5(2-7)+4\div2^2-7
        </md> 
        <md>
            3\sqrt{16}-5(-5)+4\div2^2-7
        </md> 
        <md>
            3\cdot4-5(-5)+4\div2^2-7
        </md> 
        <md>
            3\cdot4-5(-5)+4\div4-7
        </md> 
        <md>
            12-5(-5)+4\div4-7
        </md> 
        <md>
            12+25+4\div4-7
        </md> 
        <md>
            12+25+1-7
        </md> 
        <md>
           37+1-7
        </md> 
        <md>
           38-7
        </md> 
        <md>
           31
        </md> 
        </p>
    </solution>
  </exercise>

  <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            3^{\sqrt{4}}\div(3-2\cdot8)+4-2\cdot\frac{2-1}{9-4}
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            3^{\sqrt{4}}\div(3-16)+4-2\cdot\frac{2-1}{9-4}
        </md>
        <md>
            3^{\sqrt{4}}\div(-13)+4-2\cdot\frac{2-1}{9-4}
        </md>
        <md>
            3^{\sqrt{4}}\div(-13)+4-2\cdot\frac{1}{9-4}
        </md>
        <md>
            3^{\sqrt{4}}\div(-13)+4-2\cdot\frac{1}{5}
        </md>
        <md>
            3^{2}\div(-13)+4-2\cdot\frac{1}{5}
        </md>
        <md>
            9\div(-13)+4-2\cdot\frac{1}{5}
        </md>
        <md>
            -\frac{9}{13}+4-2\cdot\frac{1}{5}
        </md>
        <md>
            -\frac{9}{13}+4-\frac{2}{5}
        </md>
        <md>
            -\frac{9}{13}+\frac{52}{13}-\frac{2}{5}
        </md>
        <md>
            \frac{43}{13}-\frac{2}{5}
        </md>
        <md>
            \frac{215}{65}-\frac{26}{65}
        </md>
        <md>
            \frac{189}{65}
        </md>

        </p>
    </solution>
  </exercise>

  <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            4\cdot4-4\div4+4^{(4-4)}+(4+4)\div4
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            4\cdot4-4\div4+4^{0}+(4+4)\div4
            </md>
            <md>
            4\cdot4-4\div4+4^{0}+8\div4
            </md>
            <md>
            4\cdot4-4\div4+1+8\div4
            </md>
            <md>
            16-4\div4+1+8\div4
            </md>
            <md>
            16-1+1+8\div4
            </md>
            <md>
            16-1+1+2
            </md>
            <md>
            15+1+2
            </md>
            <md>
            16+2
            </md>
            <md>
            18
            </md>
        </p>
    </solution>
 </exercise>

 <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            3-4^{7\div(5+9)}\cdot(7-3)^2\div(8-12)
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            3-4^{7\div(5+9)}\cdot(7-3)^2\div(8-12)
        </md>
        <md>
            3-4^{7\div14}\cdot(7-3)^2\div(8-12)
        </md>
         <md>
            3-4^{\frac{1}{2}}\cdot(7-3)^2\div(8-12)
        </md>
        <md>
            3-4^{\frac{1}{2}}\cdot(4)^2\div(8-12)
        </md>
        <md>
            3-4^{\frac{1}{2}}\cdot(4)^2\div(-4)
        </md>
        <md>
            3-2\cdot(4)^2\div(-4)
        </md>
        <md>
            3-2\cdot16\div(-4)
        </md>
        <md>
            3-32\div(-4)
        </md>
        <md>
            3+8
        </md>
        <md>
            11
        </md>
        </p>
    </solution>
 </exercise>

 <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            9+3\div5+1-2\cdot4^2\div3
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            9+3\div5+1-2\cdot4^2\div3
        </md>
        <md>
            9+3\div5+1-2\cdot16\div3
        </md>
        <md>
            9+\frac{3}{5}+1-2\cdot16\div3
        </md>
        <md>
            9+\frac{3}{5}+1-32\div3
        </md>
        <md>
            9+\frac{3}{5}+1-\frac{32}{3}
        </md>
        <md>
            \frac{45}{5}+\frac{3}{5}+1-\frac{32}{3}
        </md>
         <md>
            \frac{48}{5}+1-\frac{32}{3}
        </md>
        <md>
            \frac{48}{5}+\frac{5}{5}-\frac{32}{3}
        </md>
        <md>
            \frac{53}{5}-\frac{32}{3}
        </md>
        <md>
            \frac{159}{15}-\frac{160}{15}
        </md>
        <md>
            -\frac{1}{15}
        </md>
        </p>
    </solution>
 </exercise>

  <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            \frac{8-5}{9-12}+3\cdot4^2-(2-7)^2
        </md>
        
    </p>
    <solution>
        <p>
            <md>
            \frac{8-5}{9-12}+3\cdot4^2-(2-7)^2
            </md>
            <md>
                \frac{3}{9-12}+3\cdot4^2-(2-7)^2
            </md>
            <md>
                \frac{3}{-3}+3\cdot4^2-(2-7)^2
            </md>
            <md>
                \frac{3}{-3}+3\cdot4^2-(-5)^2
            </md>
            <md>
                \frac{3}{-3}+3\cdot16-(-5)^2
            </md>
            <md>
                \frac{3}{-3}+3\cdot16-25
            </md>
            <md>
                -1+3\cdot16-25
            </md>
            <md>
                -1+48-25
            </md>
            <md>
                47-25
            </md>
            <md>
                22
            </md>
            
            
        </p>
    </solution>
    
  </exercise>
  <exercise workspace="0.5in">
    <p>
        Simplify the following expression using correct order of operations:
        <md>
            \frac{3-5}{8-4}(9+3)-4\div4\cdot2+4^2\cdot2
        </md>
        
    </p>
    <solution>
        <p>
             <md>
            \frac{3-5}{8-4}(9+3)-4\div4\cdot2+4^2\cdot2
            </md>
            <md>
            \frac{-2}{8-4}(9+3)-4\div4\cdot2+4^2\cdot2
            </md>
            <md>
            \frac{-2}{4}(9+3)-4\div4\cdot2+4^2\cdot2
            </md>
            <md>
            \frac{-2}{4}(12)-4\div4\cdot2+4^2\cdot2
            </md>
            <md>
            \frac{-2}{4}(12)-4\div4\cdot2+16\cdot2
            </md>
            <md>
            -\frac{1}{2}(12)-4\div4\cdot2+16\cdot2
            </md>
            <md>
            -6-4\div4\cdot2+16\cdot2
            </md>
            <md>
            -6-1\cdot2+16\cdot2
            </md>
            <md>
            -6-2+16\cdot2
            </md>
            <md>
            -6-2+32
            </md>
            <md>
            -8+32
            </md>
            <md>
            24
            </md>
        </p>
    </solution>
  </exercise>
  



    </worksheet>