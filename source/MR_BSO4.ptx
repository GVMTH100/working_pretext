<worksheet xml:id="BSO4_PP" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Basic Skills and Operations #4</title>

    <objectives>
                    <ul>
                        
                <li>    <p>
                    <alert>BSO #4:</alert> I can identify a numerical pattern and generalize the pattern using variables.
                </p></li>
               
                </ul>
            
    </objectives>

   <exercise>
        <introduction>
            <p>
                Consider the following table which lists the even numbers from 0 to 96.
            </p>
            <tabular halign="center" top="minor" bottom="minor" left="minor" right="minor">
                <row>
                    <cell>0</cell>
                    <cell>2</cell>
                    <cell>4</cell>
                    <cell>6</cell>
                    <cell>8</cell>
                    <cell>10</cell>
                    <cell>12</cell>
                </row>
                <row>
                    <cell>14</cell>
                    <cell>16</cell>
                    <cell>18</cell>
                    <cell>20</cell>
                    <cell>22</cell>
                    <cell>24</cell>
                    <cell>26</cell>
                </row>
                <row>
                    <cell>28</cell>
                    <cell>30</cell>
                    <cell>32</cell>
                    <cell>34</cell>
                    <cell>36</cell>
                    <cell>38</cell>
                    <cell>40</cell>
                </row>
                <row>
                    <cell>42</cell>
                    <cell>44</cell>
                    <cell>46</cell>
                    <cell>48</cell>
                    <cell>50</cell>
                    <cell>52</cell>
                    <cell>54</cell>
                </row>
                <row>
                    <cell>56</cell>
                    <cell>58</cell>
                    <cell>60</cell>
                    <cell>62</cell>
                    <cell>64</cell>
                    <cell>66</cell>
                    <cell>68</cell>
                </row>
                <row>
                    <cell>70</cell>
                    <cell>72</cell>
                    <cell>74</cell>
                    <cell>76</cell>
                    <cell>78</cell>
                    <cell>80</cell>
                    <cell>82</cell>
                </row>
                <row>
                    <cell>84</cell>
                    <cell>86</cell>
                    <cell>88</cell>
                    <cell>90</cell>
                    <cell>92</cell>
                    <cell>94</cell>
                    <cell>96</cell>
                </row>
            </tabular>
        </introduction>
        <task workspace="0.25in">
            <statement>
                <p>
                   Choose a number on the interior of the table and describe the pattern as you move up from that position. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move up a column of the table the values are decreasing by 14
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move down diagonally to the right.
                </p>
            </statement>
            <solution>
                <p>
                    As we move down and right along a diagonal the values are increasing by 16.
                </p>
            </solution>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Choose a number on the interior of the table and describe the pattern as you move to the left. 
                </p>
            </statement>
            <solution>
                <p>
                    As we move to the left on the table the values are decreasing by 2.  
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    Choose one square from the interior of the table and replace the value with <m>n</m>. Write each of the values around this number in terms of <m>n</m>, using the patterns you described above.
                </p>
                <tabular left="minor" top="minor" halign="center">
          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <m>n</m> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>

          <row bottom="minor">
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
            <cell right="minor">
              <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/> <nbsp/>
            </cell>
          </row>
        </tabular>
            </statement>
        <solution>
            <p>
                <tabular left="minor" top="minor" right="minor" bottom="minor" halign="center">
                    <row>
                        <cell><m>n-16</m></cell>
                        <cell><m>n-14</m></cell>
                        <cell><m>n-12</m></cell>
                    </row>
                    <row>
                        <cell><m>n-2</m></cell>
                        <cell><m>n</m></cell>
                        <cell><m>n+2</m></cell>
                    </row>
                    <row>
                        <cell><m>n+12</m></cell>
                        <cell><m>n+14</m></cell>
                        <cell><m>n+16</m></cell>
                    </row>
                </tabular>
            </p>
        </solution>
        </task>
    </exercise>

