    <exercise>
      <introduction>
        <p>
          Summarize your understanding of linear functions. Answer the questions below. 
        </p>
      </introduction>

      <task workspace="0.25in">
        <statement>
          <p>
            What do you know about the slope?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the slope from a table?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the slope from a graph?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the slope from an equation?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the slope from a context or story? 
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What do you know about the <m>y</m>-intercept?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the <m>y</m>-intercept from a table?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the <m>y</m>-intercept from a graph?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the <m>y</m>-intercept from an equation?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            How can you determine the <m>y</m>-intercept from a context or story?
          </p>
        </statement>
      </task>

    </exercise>

      <exercise>
