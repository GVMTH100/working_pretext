<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="HW9" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Homework Set 9</title>
 
  <introduction>
    <p>
      <alert>Directions:</alert> Complete each of the following problems showing work and supporting your answers with appropriate explanation.  You are welcome to use notes and a graphing calculator to complete these problems.  Other resources are not permitted.  Collaboration with other students in the class is allowed, but please note any collaborators on your homework sheet.
    </p>
  </introduction>

   <exercise xml:id="exer-monop-reg">
      <introduction>
        <p>
          Each space in the Monopoly board game is numbered with GO being space 0. The price of the property by space number is provided.
        </p>
         <tabular halign='center' top='minor' left='minor'>
              <row bottom='minor' header='yes'>
                <cell right='minor'>Space Number</cell>
                <cell right='major'><line>Price of</line><line>Property</line></cell>
                <cell right='minor'>Space Number</cell>
                <cell right='minor'><line>Price of</line><line>Property</line></cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>1</cell>
                <cell right='major'>60</cell>
                <cell right='minor'>21</cell>
                <cell right='minor'>220</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>3</cell>
                <cell right='major'>60</cell>
                <cell right='minor'>23</cell>
                <cell right='minor'>220</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>6</cell>
                <cell right='major'>100</cell>
                <cell right='minor'>24</cell>
                <cell right='minor'>240</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>8</cell>
                <cell right='major'>100</cell>
                <cell right='minor'>26</cell>
                <cell right='minor'>260</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>9</cell>
                <cell right='major'>120</cell>
                <cell right='minor'>27</cell>
                <cell right='minor'>260</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>11</cell>
                <cell right='major'>140</cell>
                <cell right='minor'>29</cell>
                <cell right='minor'>280</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>13</cell>
                <cell right='major'>140</cell>
                <cell right='minor'>31</cell>
                <cell right='minor'>300</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>14</cell>
                <cell right='major'>160</cell>
                <cell right='minor'>32</cell>
                <cell right='minor'>300</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>16</cell>
                <cell right='major'>180</cell>
                <cell right='minor'>34</cell>
                <cell right='minor'>320</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>18</cell>
                <cell right='major'>180</cell>
                <cell right='minor'>37</cell>
                <cell right='minor'>350</cell>
              </row>

              <row bottom='minor'>
                <cell right='minor'>19</cell>
                <cell right='major'>200</cell>
                <cell right='minor'>39</cell>
                <cell right='minor'>400</cell>
              </row>

            </tabular>
      </introduction>

      <task>
        <statement>
          <p>
            Plot the data in Desmos.  (You do not need to include your graph)
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            Find a regression equation to fit the data. 
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What is the slope? What does the slope represent in this context?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What is the <m>y</m>-intercept? What does the <m>y</m>-intercept represent in this context?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What does the regression line predict for the price for property 18?
          </p>
          
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What property number would cost $500 if the board was expanded to include more spaces?
          </p>
        </statement>
      </task>

    </exercise>

    <exercise>
      <introduction>
        <p>
          In the next table, several Monopoly properties were deleted from the previous question. Only the third property in each group of three of the same colored properties remain in this table. Space numbers and prices are provided.
        </p>
        
        <tabular halign="center" top='minor' left='minor'>
            <row bottom='minor' header='yes'>
              <cell right='minor'>Space Number</cell>
              <cell right='minor'>Price of Property</cell>
            </row>

            <row bottom='minor'>
              <cell right='minor'>9</cell>
              <cell right='minor'>120</cell>
            </row>

            <row bottom='minor'>
              <cell right='minor'>14</cell>
              <cell right='minor'>160</cell>
            </row>

            <row bottom='minor'>
              <cell right='minor'>19</cell>
              <cell right='minor'>200</cell>
            </row>
            
            <row bottom='minor'>
              <cell right='minor'>24</cell>
              <cell right='minor'>240</cell>
            </row>

            <row bottom='minor'>
              <cell right='minor'>29</cell>
              <cell right='minor'>280</cell>
            </row>

            <row bottom='minor'>
              <cell right='minor'>34</cell>
              <cell right='minor'>320</cell>
            </row>
            </tabular>
         
      </introduction>

      <task workspace="0.25in">
        <statement>
          <p>
            Determine an equation to fit this new table.
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What is the slope? What does the slope mean in this context?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            What is the <m>y</m>-intercept? What does the <m>y</m>-intercept mean in this context?
          </p>
        </statement>
      </task>

      
      <task workspace="0.25in">
        <statement>
          <p>
            If every space had a price associated with it, how much would space 25 cost?
          </p>
        </statement>
      </task>

      <task workspace="0.25in">
        <statement>
          <p>
            Which space number would cost $500?
          </p>
        </statement>
      </task>

    </exercise>
</worksheet>